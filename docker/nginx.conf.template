# Rendered by the official nginx image: ${NGINX_MAX_BODY_MB} is substituted from the container environment
# (only variables that are defined are replaced, so nginx's own $variables are untouched).
# TLS: terminate it here (see README "Production deployment") or in a load balancer in front of this container.

server_tokens off;

upstream nexora_web { server web:3000; keepalive 16; }
upstream nexora_api { server api:4000; keepalive 16; }

map $http_upgrade $connection_upgrade { default upgrade; '' ''; }

server {
  listen 80 default_server;
  server_name _;

  # Total request body (all files of one job). Per-file size is enforced by the API (MAX_UPLOAD_MB).
  client_max_body_size ${NGINX_MAX_BODY_MB}m;
  client_body_timeout 120s;
  send_timeout 300s;

  # Security headers (nosniff, frame-ancestors, referrer policy, CSP basics) are set by the web app and the API
  # (Next.js headers / @fastify/helmet), so they are not repeated here. Add HSTS here once you serve HTTPS.

  # Used by the container health check; does not touch the upstreams.
  location = /healthz { access_log off; default_type text/plain; return 200 "ok\n"; }

  # API: stream uploads to Fastify instead of buffering whole files on the proxy's disk.
  location /api/ {
    proxy_pass http://nexora_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
  }

  # Web app (Next.js).
  location / {
    proxy_pass http://nexora_web;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
  }
}
