# syntax=docker/dockerfile:1.7
# NexoraTools API (Fastify). Also used for the one-shot `migrate` service (it carries the Prisma CLI).
ARG NODE_IMAGE=node:22-bookworm-slim

# ---------- build ----------
FROM ${NODE_IMAGE} AS build
WORKDIR /app
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates openssl \
 && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY workers/worker/package.json workers/worker/
COPY packages/shared/package.json packages/shared/
COPY packages/config/package.json packages/config/
COPY packages/database/package.json packages/database/
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund
COPY packages packages
COPY apps/api apps/api
RUN npm run build:packages && npm run build -w @nexora/api

# ---------- runtime ----------
FROM ${NODE_IMAGE} AS runtime
ENV NODE_ENV=production
WORKDIR /app
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates openssl \
 && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY workers/worker/package.json workers/worker/
COPY packages/shared/package.json packages/shared/
COPY packages/config/package.json packages/config/
COPY packages/database/package.json packages/database/
# Production dependencies of the api and its internal packages only (no web / worker / dev tooling).
RUN --mount=type=cache,target=/root/.npm \
    npm ci --omit=dev --no-audit --no-fund --include-workspace-root=false \
      -w @nexora/api -w @nexora/shared -w @nexora/config -w @nexora/database
COPY --from=build /app/packages/shared/dist packages/shared/dist
COPY --from=build /app/packages/config/dist packages/config/dist
COPY --from=build /app/packages/database/dist packages/database/dist
COPY --from=build /app/apps/api/dist apps/api/dist
COPY packages/database/prisma packages/database/prisma
# Generate the Prisma client into this image's node_modules.
RUN npx prisma generate --schema packages/database/prisma/schema.prisma \
 && mkdir -p /data/storage && chown -R node:node /data /app
USER node
ENV API_HOST=0.0.0.0 API_PORT=4000 STORAGE_DIR=/data/storage
EXPOSE 4000
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.API_PORT||4000)+'/api/health').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"
CMD ["node", "apps/api/dist/server.js"]
