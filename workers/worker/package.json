{
  "name": "@nexora/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "cleanup:once": "tsx --env-file=../../.env src/cleanup-cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nexora/config": "*",
    "@nexora/database": "*",
    "@nexora/shared": "*",
    "archiver": "^7.0.1",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.1",
    "pdf-lib": "^1.17.1",
    "pino": "^9.5.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": { "@types/archiver": "^6.0.3", "@types/node": "^22.9.0", "tsx": "^4.19.2", "typescript": "^5.6.3" }
}
